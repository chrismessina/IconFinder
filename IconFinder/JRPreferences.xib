<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23727" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23727"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="JRPreferencesController">
            <connections>
                <outlet property="window" destination="W1" id="W1o"/>
                <outlet property="deepScanSwitch" destination="SW1SW" id="out1"/>
                <outlet property="hideDupSwitch" destination="SW2SW" id="out2"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application"/>
        <window title="Preferences" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" animationBehavior="default" id="W1">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="NO" resizable="NO"/>
            <rect key="contentRect" x="0" y="0" width="420" height="200"/>
            <view key="contentView" id="C1">
                <rect key="frame" x="0.0" y="0.0" width="420" height="200"/>
                <subviews>
                    <stackView orientation="horizontal" alignment="firstBaseline" distribution="fill" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="STK1">
                        <rect key="frame" x="20" y="140" width="380" height="22"/>
                        <subviews>
                            <textField editable="NO" selectable="NO" translatesAutoresizingMaskIntoConstraints="NO" id="LBL_TITLE1">
                                <textFieldCell key="cell" title="Enable Deep Scan" id="LBL_TITLE1c">
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <switch translatesAutoresizingMaskIntoConstraints="NO" id="SW1SW">
                                <connections>
                                    <action selector="deepScanToggled:" target="-2" id="act1"/>
                                </connections>
                            </switch>
                        </subviews>
                    </stackView>
                    <textField translatesAutoresizingMaskIntoConstraints="NO" id="LBL1">
                        <rect key="frame" x="40" y="110" width="360" height="34"/>
                        <textFieldCell key="cell" title="Deep Scan walks the filesystem for images. It may take significantly longer than the default fast scan (Spotlight)." id="LBL1c" lineBreakMode="wordWrapping" usesSingleLineMode="NO">
                            <font key="font" metaFont="system" size="11"/>
                            <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <stackView orientation="horizontal" alignment="firstBaseline" distribution="fill" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="STK2">
                        <rect key="frame" x="20" y="70" width="380" height="22"/>
                        <subviews>
                            <textField editable="NO" selectable="NO" translatesAutoresizingMaskIntoConstraints="NO" id="LBL_TITLE2">
                                <textFieldCell key="cell" title="Hide Duplicates" id="LBL_TITLE2c">
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <switch translatesAutoresizingMaskIntoConstraints="NO" id="SW2SW">
                                <connections>
                                    <action selector="hideDuplicatesToggled:" target="-2" id="act2"/>
                                </connections>
                            </switch>
                        </subviews>
                    </stackView>
                </subviews>
                <constraints>
                    <constraint firstItem="STK1" firstAttribute="top" secondItem="C1" secondAttribute="top" constant="20" id="c1"/>
                    <constraint firstItem="STK1" firstAttribute="leading" secondItem="C1" secondAttribute="leading" constant="20" id="c2"/>
                    <constraint firstItem="LBL1" firstAttribute="top" secondItem="STK1" secondAttribute="bottom" constant="6" id="c3"/>
                    <constraint firstItem="LBL1" firstAttribute="leading" secondItem="C1" secondAttribute="leading" constant="40" id="c4"/>
                    <constraint firstItem="LBL1" firstAttribute="trailing" secondItem="C1" secondAttribute="trailing" constant="20" id="c4b"/>
                    <constraint firstItem="STK2" firstAttribute="top" secondItem="LBL1" secondAttribute="bottom" constant="16" id="c5"/>
                    <constraint firstItem="STK2" firstAttribute="leading" secondItem="C1" secondAttribute="leading" constant="20" id="c6"/>
                </constraints>
            </view>
        </window>
    </objects>
</document>

